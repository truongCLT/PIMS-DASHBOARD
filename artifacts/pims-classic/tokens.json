{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "PIMS Classic design tokens (DTCG). Extracted from the original PIMS Dashboard 2 (Current) look: navy top bar (#2e4568), bright blue accent (#1e6fdd), dark navy KPI cards (#33415f), cyan/orange KPI highlights, light blue-grey page background, Noto Sans KR + Inter typography. THIS FILE IS THE SINGLE SOURCE OF TRUTH — edit here only; generated files are rebuilt by scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#e8edf3" },
      "foreground": { "$value": "#1a2d4d" },
      "border": { "$value": "#d5dce6" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#1a2d4d" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1a2d4d" },
      "primary": {
        "$value": "#1e6fdd",
        "$description": "Bright blue used for active tabs, links, and primary actions."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": {
        "$value": "#2e4568",
        "$description": "Navy used for the top bar and strong emphasis."
      },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#f2f4f7" },
      "mutedForeground": { "$value": "#44546a" },
      "accent": { "$value": "#e8ecf5" },
      "accentForeground": { "$value": "#1a2d4d" },
      "destructive": {
        "$value": "#ff5722",
        "$description": "Orange-red used for below-target KPI highlights."
      },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#ccd4dd" },
      "ring": { "$value": "#1e6fdd" },
      "chart1": { "$value": "#1565c0" },
      "chart2": { "$value": "#4472ca" },
      "chart3": { "$value": "#5b9bd5" },
      "chart4": { "$value": "#4caf50" },
      "chart5": { "$value": "#00bcd4" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#44546a" },
      "sidebarBorder": { "$value": "#d5dce6" },
      "sidebarPrimary": { "$value": "#1e6fdd" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#e8ecf5" },
      "sidebarAccentForeground": { "$value": "#1a2d4d" },
      "sidebarRing": { "$value": "#1e6fdd" }
    },
    "dark": {
      "background": { "$value": "#141d2c" },
      "foreground": { "$value": "#e6ecf5" },
      "border": { "$value": "#2e4568" },
      "card": { "$value": "#1f2c42" },
      "cardForeground": { "$value": "#e6ecf5" },
      "popover": { "$value": "#1f2c42" },
      "popoverForeground": { "$value": "#e6ecf5" },
      "primary": { "$value": "#4a8df0" },
      "primaryForeground": { "$value": "#0d1626" },
      "secondary": { "$value": "#33415f" },
      "secondaryForeground": { "$value": "#e6ecf5" },
      "muted": { "$value": "#26334a" },
      "mutedForeground": { "$value": "#9fb0cc" },
      "accent": { "$value": "#26334a" },
      "accentForeground": { "$value": "#e6ecf5" },
      "destructive": { "$value": "#ff7043" },
      "destructiveForeground": { "$value": "#0d1626" },
      "input": { "$value": "#33415f" },
      "ring": { "$value": "#4a8df0" },
      "chart1": { "$value": "#4a8df0" },
      "chart2": { "$value": "#6b93e0" },
      "chart3": { "$value": "#7ab4e8" },
      "chart4": { "$value": "#66bb6a" },
      "chart5": { "$value": "#26c6da" },
      "sidebar": { "$value": "#0f1826" },
      "sidebarForeground": { "$value": "#9fb0cc" },
      "sidebarBorder": { "$value": "#26334a" },
      "sidebarPrimary": { "$value": "#4a8df0" },
      "sidebarPrimaryForeground": { "$value": "#0d1626" },
      "sidebarAccent": { "$value": "#1f2c42" },
      "sidebarAccentForeground": { "$value": "#e6ecf5" },
      "sidebarRing": { "$value": "#4a8df0" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Noto Sans KR", "Inter", "sans-serif"],
        "$description": "Korean-first UI/body typeface; Inter covers Latin."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.375rem",
      "$description": "Classic PIMS cards use slightly tighter 6px corners."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
