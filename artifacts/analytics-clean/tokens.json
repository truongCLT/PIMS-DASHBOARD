      "primaryForeground": { "$value": "#0f1826" },
      "secondary": { "$value": "#5b9bd5" },
      "secondaryForeground": { "$value": "#0f1826" },
      "muted": { "$value": "#26334a" },
      "mutedForeground": { "$value": "#9ab0c8" },
      "accent": { "$value": "#26334a" },
      "accentForeground": { "$value": "#e7edf6" },
      "destructive": { "$value": "#e57373" },
      "destructiveForeground": { "$value": "#0f1826" },
      "input": { "$value": "#2c3b52" },
      "ring": { "$value": "#6b93e0" },
      "chart1": { "$value": "#6b93e0" },
      "chart2": { "$value": "#7ab4e8" },
      "chart3": { "$value": "#eb984e" },
      "chart4": { "$value": "#22b8d4" },
      "chart5": { "$value": "#10b981" },
      "sidebar": { "$value": "#0f1826" },
      "sidebarForeground": { "$value": "#8fa8c2" },
