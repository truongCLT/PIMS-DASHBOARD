{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Analytics Clean design tokens (DTCG). Extracted from the PIMS Dashboard 2 'Analytics Clean' visual language: calm blue palette (#4472ca / #5b9bd5), soft coral for destructive (#e57373), light blue-grey surfaces and borders, Noto Sans KR + Inter typography. THIS FILE IS THE SINGLE SOURCE OF TRUTH — edit here only; generated files are rebuilt by scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f2f5fa" },
      "foreground": { "$value": "#1e2a3b" },
      "border": { "$value": "#dde3ee" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#1e2a3b" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1e2a3b" },
      "primary": {
        "$value": "#4472ca",
        "$description": "Analytics Clean plan-blue. Buttons, links, active tabs, emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": {
        "$value": "#5b9bd5",
        "$description": "Light blue for the 'actual' data series and secondary emphasis."
      },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#e9eef6" },
      "mutedForeground": { "$value": "#6b7d96" },
      "accent": { "$value": "#e4ecf9" },
      "accentForeground": { "$value": "#1e2a3b" },
      "destructive": {
        "$value": "#e57373",
        "$description": "Soft coral used for outflow/negative values."
      },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#dde3ee" },
      "ring": { "$value": "#4472ca" },
      "chart1": { "$value": "#4472ca" },
