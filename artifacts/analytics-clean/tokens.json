      "sidebarBorder": { "$value": "#2c3b52" },
      "sidebarPrimary": { "$value": "#4472ca" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#28374d" },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#4472ca" }
    },
    "dark": {
      "background": { "$value": "#141c29" },
      "foreground": { "$value": "#e7edf6" },
      "border": { "$value": "#2c3b52" },
