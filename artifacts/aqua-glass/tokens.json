{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#eef2f7" },
      "foreground": { "$value": "#16294a" },
      "border": { "$value": "#e2e9f3" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#16294a" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#16294a" },
      "primary": {
        "$value": "#2f7cf6",
        "$description": "Bright aqua blue. Pill buttons, active nav, links, emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#1e3a6e" },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#f2f6fb" },
      "mutedForeground": { "$value": "#7c8ba3" },
      "accent": { "$value": "#d8f6ea" },
      "accentForeground": { "$value": "#1c7a5a" },
      "destructive": { "$value": "#f2736a" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#dde6f1" },
      "ring": { "$value": "#2f7cf6" },
      "chart1": { "$value": "#2f7cf6" },
      "chart2": { "$value": "#35c7c0" },
      "chart3": { "$value": "#5fe0a8" },
      "chart4": { "$value": "#6db9f2" },
      "chart5": { "$value": "#1e3a6e" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#44546a" },
      "sidebarBorder": { "$value": "#e2e9f3" },
      "sidebarPrimary": { "$value": "#2f7cf6" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#e7f1fd" },
      "sidebarAccentForeground": { "$value": "#1e3a6e" },
      "sidebarRing": { "$value": "#2f7cf6" }
    },
    "dark": {
      "background": { "$value": "#0f1a2e" },
      "foreground": { "$value": "#e7eef8" },
      "border": { "$value": "#24334e" },
      "card": { "$value": "#16233c" },
      "cardForeground": { "$value": "#e7eef8" },
      "popover": { "$value": "#16233c" },
      "popoverForeground": { "$value": "#e7eef8" },
      "primary": { "$value": "#4f95f7" },
      "primaryForeground": { "$value": "#0f1a2e" },
      "secondary": { "$value": "#24334e" },
      "secondaryForeground": { "$value": "#e7eef8" },
      "muted": { "$value": "#1b2a44" },
      "mutedForeground": { "$value": "#8fa2bd" },
      "accent": { "$value": "#143d31" },
      "accentForeground": { "$value": "#7fe7c0" },
      "destructive": { "$value": "#e0655c" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#24334e" },
      "ring": { "$value": "#4f95f7" },
      "chart1": { "$value": "#4f95f7" },
      "chart2": { "$value": "#3fd8d0" },
      "chart3": { "$value": "#6ee9b4" },
      "chart4": { "$value": "#82c4f5" },
      "chart5": { "$value": "#93aed6" },
      "sidebar": { "$value": "#121e34" },
      "sidebarForeground": { "$value": "#c4d1e4" },
      "sidebarBorder": { "$value": "#24334e" },
      "sidebarPrimary": { "$value": "#4f95f7" },
      "sidebarPrimaryForeground": { "$value": "#0f1a2e" },
      "sidebarAccent": { "$value": "#1b2a44" },
      "sidebarAccentForeground": { "$value": "#e7eef8" },
      "sidebarRing": { "$value": "#4f95f7" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "Noto Sans KR", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Base corner radius; large, soft pill-like corners are core to the Aqua Glass look."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
