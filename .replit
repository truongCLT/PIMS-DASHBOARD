modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/aqua-glass: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/aqua-glass"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/aqua-glass run dev"
cwd = "./artifacts/aqua-glass"
waitForPort = 18569
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "18569"
BASE_PATH = "/aqua-glass/"

[[workflows.workflow]]
name = "artifacts/pims-classic: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/pims-classic"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/pims-classic run dev"
cwd = "./artifacts/pims-classic"
waitForPort = 19445
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "19445"
BASE_PATH = "/pims-classic/"

[[workflows.workflow]]
name = "artifacts/analytics-clean: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/analytics-clean"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/analytics-clean run dev"
cwd = "./artifacts/analytics-clean"
waitForPort = 23438
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "23438"
BASE_PATH = "/analytics-clean/"

[[workflows.workflow]]
name = "artifacts/pims-dashboard-2: web"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/pims-dashboard-2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/pims-dashboard-2 run dev"
cwd = "./artifacts/pims-dashboard-2"
waitForPort = 23700
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "23700"
BASE_PATH = "/pims-dashboard-2/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
